rules_version = '2';

// Règles Firebase Storage. Pour l'instant, le seul usage est le stockage
// des images importées depuis un document Word dans l'onglet
// "Procédures" (page Aide) : voir procedures/{procedureId}/images/...
service firebase.storage {
  match /b/{bucket}/o {
    match /procedures/{procedureId}/images/{fichier} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }
  }
}
