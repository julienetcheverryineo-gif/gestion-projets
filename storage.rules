rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Photos du chat, rangées par chantier. Lecture réservée aux personnes
    // connectées à l'application, écriture limitée aux images de moins de
    // 10 Mo pour éviter les abus.
    match /chantiers/{chantierId}/chat/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
