rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estConnecte() {
      return request.auth != null;
    }

    function monRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function estChefOuAdmin() {
      return estConnecte() && (monRole() == 'chef_de_projet' || monRole() == 'admin');
    }

    // Le profil "RA Électricité" gère son propre périmètre (chantiers
    // service électricité, devis importés) avec les mêmes droits qu'un
    // chef de projet côté Automatisme.
    function estGestionnaireElec() {
      return estConnecte() && (monRole() == 'ra_electricite' || estChefOuAdmin());
    }

    // Chaque utilisateur peut lire/modifier son propre profil.
    // Seuls les chefs de projet / admins peuvent changer un rôle.
    match /users/{userId} {
      allow read: if estConnecte();
      allow create: if request.auth.uid == userId || estChefOuAdmin();
      allow update: if request.auth.uid == userId || estChefOuAdmin();
      allow delete: if estChefOuAdmin();
    }

    // Équipements régulés (notre périmètre) : lecture pour tous, gestion
    // réservée aux chefs de projet/admins
    match /regequipements/{regId} {
      allow read: if estConnecte();
      allow create, update, delete: if estChefOuAdmin();
    }

    // Matériel/tâches d'un équipement régulé : lecture pour tous, tout
    // connecté peut mettre à jour le statut (coché sur le terrain)
    match /regitems/{itemId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }

    // Messages du chat par chantier : lecture pour tous les connectés,
    // chacun ne peut créer que ses propres messages (usurpation impossible),
    // suppression par l'auteur ou un chef de projet/admin (modération)
    match /messages/{messageId} {
      allow read: if estConnecte();
      allow create: if estConnecte() && request.resource.data.userId == request.auth.uid;
      allow delete: if estConnecte() &&
        (resource.data.userId == request.auth.uid || estChefOuAdmin());
    }

    // Levées de réserves : lecture pour tous, tout connecté peut créer/mettre
    // à jour (cocher une réserve levée sur le terrain), suppression réservée
    // aux chefs de projet/admins
    match /reserves/{reserveId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }

    // Chantiers : lecture pour tous les connectés, écriture réservée aux
    // chefs de projet/admins (+ RA Électricité, pour ses chantiers
    // service électricité).
    match /sites/{siteId} {
      allow read: if estConnecte();
      allow create, update, delete: if estGestionnaireElec();
    }

    // Devis Électricité (un onglet par minute importée) et leurs lignes :
    // lecture pour tous les connectés, gestion réservée au RA Électricité
    // (et aux chefs de projet/admins).
    match /elecDevis/{devisId} {
      allow read: if estConnecte();
      allow create, update, delete: if estGestionnaireElec();
    }
    match /elecLignes/{ligneId} {
      allow read: if estConnecte();
      allow create, update, delete: if estGestionnaireElec();
    }

    // Lots techniques : lecture pour tous, gestion réservée aux chefs de projet/admins
    match /lots/{lotId} {
      allow read: if estConnecte();
      allow create, update, delete: if estChefOuAdmin();
    }

    // Équipements/points : lecture pour tous, tout connecté peut mettre à jour le statut
    // (un technicien doit pouvoir cocher un équipement testé sur le terrain)
    match /equipments/{equipmentId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }

    // Tâches : lecture pour tous, création/modification pour tous les connectés
    // (un technicien doit pouvoir déplacer ses propres tâches sur le Kanban),
    // suppression réservée aux chefs de projet/admins
    match /tasks/{taskId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }

    // Temps passé (par chantier) : chacun ne peut créer/modifier que ses propres saisies
    match /timeEntries/{entryId} {
      allow read: if estConnecte();
      allow create: if estConnecte() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if estConnecte() &&
        (resource.data.userId == request.auth.uid || estChefOuAdmin());
    }

    // Notes (par chantier si chantierId renseigné, générales sinon) :
    // lecture pour tous les connectés, chacun ne peut créer que ses
    // propres notes (usurpation impossible), modification/suppression par
    // l'auteur ou un chef de projet/admin
    match /notes/{noteId} {
      allow read: if estConnecte();
      allow create: if estConnecte() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if estConnecte() &&
        (resource.data.userId == request.auth.uid || estChefOuAdmin());
    }
  }
}
