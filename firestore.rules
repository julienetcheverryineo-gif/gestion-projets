rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estConnecte() {
      return request.auth != null;
    }

    function monRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function estChefOuAdmin() {
      return estConnecte() && (monRole() == 'chef_de_projet' || monRole() == 'admin');
    }

    // Le profil "RA Électricité" gère son propre périmètre (chantiers
    // service électricité, devis importés) avec les mêmes droits qu'un
    // chef de projet côté Automatisme.
    function estGestionnaireElec() {
      return estConnecte() && (monRole() == 'ra_electricite' || estChefOuAdmin());
    }

    // Compte client (externe) : accès restreint aux seuls chantiers pour
    // lesquels il a été explicitement autorisé (voir sites.clientsAutorises),
    // affecté par un admin depuis la page Utilisateurs.
    function estClient() {
      return estConnecte() && monRole() == 'client';
    }

    function chantierAutoriseAuClient(chantierId) {
      return chantierId != null &&
        request.auth.uid in
          get(/databases/$(database)/documents/sites/$(chantierId)).data.clientsAutorises;
    }

    // Chaque utilisateur peut lire/modifier son propre profil.
    // Seuls les chefs de projet / admins peuvent changer un rôle.
    match /users/{userId} {
      allow read: if estConnecte();
      allow create: if request.auth.uid == userId || estChefOuAdmin();
      allow update: if request.auth.uid == userId || estChefOuAdmin();
      allow delete: if estChefOuAdmin();
    }

    // Équipements régulés (notre périmètre) : lecture pour tous, gestion
    // réservée aux chefs de projet/admins
    match /regequipements/{regId} {
      allow read: if estConnecte();
      allow create, update, delete: if estChefOuAdmin();
    }

    // Matériel/tâches d'un équipement régulé : lecture pour tous, tout
    // connecté peut mettre à jour le statut (coché sur le terrain)
    match /regitems/{itemId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }

    // Messages du chat par chantier : lecture pour tous les connectés,
    // chacun ne peut créer que ses propres messages (usurpation impossible),
    // suppression par l'auteur ou un chef de projet/admin (modération)
    match /messages/{messageId} {
      allow read: if estConnecte();
      allow create: if estConnecte() && request.resource.data.userId == request.auth.uid;
      allow delete: if estConnecte() &&
        (resource.data.userId == request.auth.uid || estChefOuAdmin());
    }

    // Levées de réserves : lecture/création pour tous les connectés — sauf
    // un compte client, cantonné aux réserves de ses chantiers autorisés.
    // Mise à jour (statut, etc.) réservée à l'équipe interne : un client
    // saisit et suit ses réserves, il ne modifie pas leur traitement.
    // Suppression réservée aux chefs de projet/admins.
    match /reserves/{reserveId} {
      allow read: if estConnecte() &&
        (!estClient() || chantierAutoriseAuClient(resource.data.chantierId));
      allow create: if estConnecte() &&
        (!estClient() || chantierAutoriseAuClient(request.resource.data.chantierId));
      allow update: if estConnecte() && !estClient();
      allow delete: if estChefOuAdmin();
    }

    // Chantiers : lecture pour tous les connectés — sauf un compte client,
    // cantonné aux chantiers listés dans son champ clientsAutorises.
    // Écriture réservée aux chefs de projet/admins (+ RA Électricité, pour
    // ses chantiers service électricité) ; c'est aussi par cette voie que
    // la page Utilisateurs affecte/retire un client à un chantier.
    match /sites/{siteId} {
      allow read: if estConnecte() &&
        (!estClient() || request.auth.uid in resource.data.clientsAutorises);
      allow create, update, delete: if estGestionnaireElec();
    }

    // Devis Électricité (un onglet par minute importée) et leurs lignes :
    // lecture pour tous les connectés, gestion réservée au RA Électricité
    // (et aux chefs de projet/admins).
    match /elecDevis/{devisId} {
      allow read: if estConnecte();
      allow create, update, delete: if estGestionnaireElec();
    }
    match /elecLignes/{ligneId} {
      allow read: if estConnecte();
      allow create, update, delete: if estGestionnaireElec();
    }
    // Groupes de lignes de devis (regroupement + gestion d'avancement par
    // groupe ou par ligne) : mêmes droits que les lignes qu'ils regroupent.
    match /elecGroupes/{groupeId} {
      allow read: if estConnecte();
      allow create, update, delete: if estGestionnaireElec();
    }

    // Imports bruts des exports SAP (achats + pointages), page "Import
    // SAP" côté Électricité : mêmes droits que les devis Électricité
    // (lecture pour tous les connectés, gestion réservée au RA
    // Électricité / chefs de projet / admins).
    match /sapImports/{importId} {
      allow read: if estConnecte();
      allow create, update, delete: if estGestionnaireElec();
    }
    match /sapLignesFo/{ligneId} {
      allow read: if estConnecte();
      allow create, update, delete: if estGestionnaireElec();
    }
    match /sapLignesMo/{ligneId} {
      allow read: if estConnecte();
      allow create, update, delete: if estGestionnaireElec();
    }

    // Pages d'aide — tables d'échange Modbus des compteurs (et futures
    // fiches similaires) : une base partagée que toute l'équipe alimente
    // et met à jour au fil de l'eau, donc lecture/création/modification
    // ouvertes à tout connecté ; suppression réservée aux chefs de
    // projet/admins (éviter une suppression accidentelle d'une fiche de
    // référence commune).
    match /modbusCompteurs/{compteurId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }
    match /modbusRegistres/{registreId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }
    match /procedures/{procedureId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }
    match /procedureBlocs/{blocId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }

    // Lots techniques : lecture pour tous, gestion réservée aux chefs de projet/admins
    match /lots/{lotId} {
      allow read: if estConnecte();
      allow create, update, delete: if estChefOuAdmin();
    }

    // Équipements/points : lecture pour tous, tout connecté peut mettre à jour le statut
    // (un technicien doit pouvoir cocher un équipement testé sur le terrain)
    match /equipments/{equipmentId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }

    // Tâches : lecture pour tous, création/modification pour tous les connectés
    // (un technicien doit pouvoir déplacer ses propres tâches sur le Kanban),
    // suppression réservée aux chefs de projet/admins
    match /tasks/{taskId} {
      allow read: if estConnecte();
      allow create, update: if estConnecte();
      allow delete: if estChefOuAdmin();
    }

    // Temps passé (par chantier) : chacun ne peut créer/modifier que ses propres saisies
    match /timeEntries/{entryId} {
      allow read: if estConnecte();
      allow create: if estConnecte() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if estConnecte() &&
        (resource.data.userId == request.auth.uid || estChefOuAdmin());
    }

    // Journal des connexions (statistiques d'usage, page admin) : chacun
    // ne peut journaliser que sa propre connexion (usurpation impossible),
    // lecture réservée aux chefs de projet/admins, pas de modification ni
    // de suppression (c'est un historique).
    match /connexions/{connexionId} {
      allow read: if estChefOuAdmin();
      allow create: if estConnecte() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Notifications (cloche in-app + déclencheur de la Cloud Function qui
    // envoie le push) : chacun ne lit/marque comme lues que les siennes.
    // La création est ouverte à tout connecté (c'est ce qui permet à un
    // client de déclencher une notif pour l'équipe, ou à un automaticien
    // d'en déclencher une pour un collègue nouvellement assigné), mais le
    // champ `type` doit être l'un des types connus et `lu` doit démarrer
    // à false — on ne modifie/supprime jamais la notification de
    // quelqu'un d'autre.
    match /notifications/{notifId} {
      allow read: if estConnecte() && resource.data.destinataireId == request.auth.uid;
      allow create: if estConnecte() &&
        request.resource.data.destinataireId is string &&
        request.resource.data.type in ['reserve_client', 'tache_retard', 'tache_assignee'] &&
        request.resource.data.lu == false;
      allow update, delete: if estConnecte() && resource.data.destinataireId == request.auth.uid;
    }

    // Notes (par chantier si chantierId renseigné, générales sinon) :
    // lecture pour tous les connectés, chacun ne peut créer que ses
    // propres notes (usurpation impossible), modification/suppression par
    // l'auteur ou un chef de projet/admin
    match /notes/{noteId} {
      allow read: if estConnecte();
      allow create: if estConnecte() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if estConnecte() &&
        (resource.data.userId == request.auth.uid || estChefOuAdmin());
    }
  }
}
